{
  "name": "godot-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "package:addon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_addon.ps1",
    "install:addon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_addon.ps1",
    "stage:blender-import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage_blender_import.ps1",
    "validate:blender-import-staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_blender_import_staging.ps1",
    "validate:blender-mcp-handoff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_blender_mcp_handoff.ps1",
    "validate:visible-editor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_visible_editor.ps1",
    "validate:all-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_all_local.ps1",
    "validate:external-project-install-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_external_project_install_smoke.ps1",
    "validate:addon-core": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_addon_core.ps1",
    "validate:live-mutation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_live_mutation.ps1",
    "validate:multi-view-capture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_multi_view_capture.ps1",
    "validate:playtest-input-visible": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_playtest_input_visible.ps1",
    "validate:playtest-scenario-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_playtest_scenario_visible.ps1 -ContractOnly",
    "validate:playtest-scenario-visible": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_playtest_scenario_visible.ps1 -RequireFutureRunner",
    "validate:playtest-scenario-evidence": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_playtest_scenario_visible.ps1 -RequireFutureRunner -RequireEvidenceRefs",
    "validate:visible-chat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_chat_host.ps1",
    "validate:chat-ux": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_chat_ux_regression.ps1",
    "validate:visible-smoke-suite": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_visible_smoke_suite.ps1",
    "validate:p9-2-visible-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_visible_smoke_suite.ps1",
    "validate:tester-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_tester_smoke.ps1",
    "validate:visible-chat-editor": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './scripts/install_addon.ps1' -ProjectRoot 'examples\\minimal_3d_project' -Apply -Replace -HostRuntime mock -HostPort 49390 | Write-Output; & './scripts/validate_visible_chat_editor.ps1' -Runtime mock -Port 49390\"",
    "validate:visible-chat-editor:auto-start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './scripts/install_addon.ps1' -ProjectRoot 'examples\\minimal_3d_project' -Apply -Replace -HostRuntime mock -HostPort 49392 | Write-Output; & './scripts/validate_visible_chat_editor.ps1' -Runtime mock -AddonStartsHost -Port 49392\"",
    "validate:visible-chat-editor:real": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './scripts/install_addon.ps1' -ProjectRoot 'examples\\minimal_3d_project' -Apply -Replace -HostRuntime app-server -HostPort 49394 | Write-Output; & './scripts/validate_visible_chat_editor.ps1' -Runtime app-server -Port 49394 -AppServerPort 49395 -ChatOnly -RequireAgentsMarker -RequireSceneContext -TurnTimeoutSeconds 240\"",
    "validate:host-cleanup-cycles": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_host_cleanup_cycles.ps1",
    "validate:failed-run-cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_failed_run_cleanup.ps1",
    "validate:real-app-background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate_real_app_server_background.ps1",
    "doctor": "npm run host:doctor && npm run doctor:mcp",
    "doctor:mcp": "npm --prefix mcp_server run doctor",
    "host:install": "npm --prefix codex_host install",
    "host:schemas": "npm --prefix codex_host run generate:schemas",
    "host:build": "npm --prefix codex_host run build",
    "host:test": "npm --prefix codex_host test",
    "host:doctor": "npm --prefix codex_host run doctor",
    "host:dev": "npm --prefix codex_host run dev",
    "start:codex-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_codex_host.ps1"
  }
}
