{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-codex-bridge.local/contracts/bridge-response.schema.json",
  "title": "Godot Codex Bridge Response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "type",
    "status",
    "created_at",
    "completed_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "godot-codex-bridge/0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "refresh_context",
        "capture_viewport_screenshot",
        "run_current_scene"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "rejected",
        "expired",
        "bridge_unavailable"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "snapshot_path": {
          "type": "string",
          "maxLength": 512
        },
        "screenshot": {
          "$ref": "#/$defs/screenshot_metadata"
        },
        "run": {
          "$ref": "#/$defs/run_result"
        }
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error_info"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_path",
        "exit_code",
        "timed_out",
        "duration_ms"
      ],
      "properties": {
        "scene_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_summary": {
          "type": "string",
          "maxLength": 4000
        },
        "stderr_summary": {
          "type": "string",
          "maxLength": 4000
        },
        "log_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "screenshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/screenshot_metadata"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "screenshot_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "screenshot_id",
        "captured_at",
        "artifact",
        "viewport",
        "privacy"
      ],
      "properties": {
        "protocol_version": {
          "const": "godot-codex-bridge/0.1"
        },
        "screenshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "scene_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "selected_node_paths": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_path",
            "project_relative_path",
            "format",
            "width",
            "height"
          ],
          "properties": {
            "local_path": {
              "type": "string",
              "maxLength": 1024
            },
            "project_relative_path": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^\\.godot/godot_codex_bridge/artifacts/screenshots/.+\\.png$"
            },
            "format": {
              "const": "png"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "mode"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "editor_3d_viewport",
                "game_viewport",
                "unknown"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "perspective",
                "orthogonal",
                "camera_preview",
                "game",
                "unknown"
              ]
            },
            "camera_node_path": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "render_scale": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 8
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "external_upload_allowed"
          ],
          "properties": {
            "classification": {
              "const": "local_sensitive_evidence"
            },
            "external_upload_allowed": {
              "const": false
            },
            "notes": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "error_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "bridge_unavailable",
            "unsupported_request",
            "invalid_payload",
            "timeout",
            "godot_error",
            "permission_denied",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
